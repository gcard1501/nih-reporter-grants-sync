# Template for your local .env file.
# Copy this file to .env, then replace the placeholder values.
# .env is listed in .gitignore and must never be committed; this template has no secrets.

# Host and port of SQL Server (the Docker container publishes port 1433)
DB_SERVER=localhost,1433

# Database the loader writes to (created by sql/01_create_tables.sql)
DB_NAME=ReporterGrants

# Login and password: the SA password you set when you started the container
DB_USER=sa
DB_PASSWORD=replace-with-your-password
